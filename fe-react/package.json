  },
  "imports": {
    "#src/*": "./src/*",
    "#client/*": "./src/client/*.ts",
    "#stores/*": "./src/stores/*.ts",
    "#types/*": "./src/types/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#utils/*": "./src/utils/*.ts",
    "#routes/*": "./src/routes/*.tsx",
    "#components/*": "./src/components/*.tsx"
